{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/notes/**)",
      "Edit(/inbox/**)",
      "Edit(/archive/**)",
      "Edit(/index.md)",
      "Bash(uv run tools/kb_check.py *)",
      "Bash(uv run tools/export.py *)",
      "Bash(uv run pytest *)",
      "Bash(git mv *)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Edit(/.obsidian/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_note.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
