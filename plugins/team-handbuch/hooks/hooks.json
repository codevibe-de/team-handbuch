{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PLUGIN_ROOT}/scripts/check_note.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
